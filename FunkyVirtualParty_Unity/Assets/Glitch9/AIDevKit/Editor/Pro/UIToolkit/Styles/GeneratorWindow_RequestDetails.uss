.request-details-node {
    display: flex;
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: column;
    margin-bottom: 5px;
    padding-top: 10px;
    height: auto;
}

.request-details-header {
    display: flex;
    flex-direction: row;
    height: 24px;
    margin-left: 10px;
    margin-right: 10px;
}

.request-details-container {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    height: 100%;
    margin-top: 12px;
    padding-left: 10px;
    padding-right: 10px;
}

.request-details-info-label-key {
    font-size: 12px;
    margin-bottom: 4px;
    color: #aaa;
    margin-right: 6px;
    width: 80px;
    height: 100%;
    -unity-font-style: bold;
    -unity-text-align: upper-left;
}

.request-details-info-label-value {
    font-size: 12px;
    margin-bottom: 4px;
    color: var(--unity-colors-text-title);
    -unity-text-align: upper-left;
    height: 100%;
    width: auto;
    flex-grow: 1;
    flex-shrink: 1;
    text-overflow: ellipsis;
    white-space: pre-wrap;
}