.text-block-root {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: auto;
}

/* 기본 텍스트 */
.text-block-plain-text {
    white-space: normal;
    padding: 2px;
    margin-bottom: 4px;
}

/* Quote 블록 */
.text-block-quote {
    white-space: normal;
    padding: 4px 8px;
    margin-bottom: 6px;
    background-color: rgba(0, 0, 0, 0.05);
    border-left-width: 2px;
    border-left-color: rgba(0, 0, 0, 0.1);
}

/* 리스트 항목 텍스트 */
.text-block-ulist {
    display: flex;
    flex-direction: row;
    white-space: normal;
    margin-top: 4px;
    margin-left: 8px;
    margin-bottom: 4px;
}

/* 리스트용 도트 */
.text-block-ulist-bullet {
    width: 14px;
}

.text-block-ulist-content {
    white-space: normal;
    flex-shrink: 1;
}

.text-block-code-block {
    display: flex;
    flex-direction: column;
    margin-bottom: 10px;
    border-radius: 4px;
}

/* 코드블럭 헤더 */
.text-block-code-header {
    display: flex;
    flex-direction: row;
    height: 26px;
    margin-top: 10px;
    padding-top: 2px;
    padding-left: 8px;
    padding-right: 8px;
    -unity-slice-left: 5;
    -unity-slice-right: 5;
    -unity-slice-top: 5;
    -unity-slice-bottom: 5;
    align-items: center;
    justify-content: space-between;
}

/* 헤더 라벨 */
.text-block-code-header-language {
    font-size: 11px;
    -unity-text-align: upper-left;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.6);
}

.text-block-code-header-buttons {
    display: flex;
    flex-direction: row;
}

.text-block-code-header-button {
    width: 22px;
    height: 22px;
    margin-top: 2px;
    margin-right: 0px;
    margin-left: 0px;
    background-color: transparent;
    border-color: transparent;
    opacity: 0.8;
    transition: background-color 0.2s ease, opacity 0.2s ease;
}

.text-block-code-header-button:hover {
    background-color: rgba(255, 255, 255, 0.1);
    opacity: 1;
}

/* 코드블럭 본문 */
.text-block-code-content {
    font-size: 12px;
    white-space: normal;
    margin: 6px 8px;
    -unity-slice-left: 5;
    -unity-slice-right: 5;
    -unity-slice-top: 5;
    -unity-slice-bottom: 5;
}

.text-block-header-level-1 {
    font-size: 16px;
}

.text-block-header-level-2 {
    font-size: 14px;
}

.text-block-header-level-3 {
    font-size: 12px;
}

.text-block-header-level-4 {
    font-size: 10px;
}

.text-block-header-level-5 {
    font-size: 8px;
}