.chat-input-field-container {
    width: 100%;
    flex-grow: 0;
    flex-shrink: 0;
    height: auto;
}

.chat-input-field {
    font-size: 12px;
    width: auto;
    height: auto;
    margin-left: 10px;
    margin-right: 10px;
    -unity-text-align: middle-left;
}

.chat-send-button {
    width: 18px;
    height: 18px;
    position: absolute;
    top: 10px;
    right: 18px;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    border-color: transparent;
    opacity: 0.6;
    transition: scale 0.15s ease-in-out, opacity 0.15s ease-in-out;
}

.chat-send-button:hover {
    scale: 1.1;
}

.chat-send-button--active {
    scale: 1.1;
    opacity: 1;
}

.chat-shortcut-button {
    display: flex;
    flex-direction: row;
    height: 20px;
    width: 140px;
    position: absolute;
    bottom: 6px;
    left: 14px;
    align-items: flex-start;
    justify-content: center;
    transition: scale 0.15s ease-in-out, opacity 0.15s ease-in-out;
}

.shortcut-icon {
    width: 16px;
    height: 16px;
}

.shortcut-label {
    font-size: 12px;
    color: var(--unity-colors-text);
    margin-left: 4px;
}