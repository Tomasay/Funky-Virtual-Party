.editor-chat-root {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 200px;
}

.main-footer {
    display: flex;
    flex-direction: column;
    height: auto;
    margin-top: 10px;
    margin-bottom: 10px;
    width: 100%;
}

.object-area {
    display: flex;
    flex-direction: row;
    margin-left: 8px;
    margin-right: 12px;
    height: auto;
    justify-content: space-between;
    flex-grow: 0;
}

.object-area-action-button {
    display: flex;
    flex-direction: row;
    width: 100%;
    height: auto;
    align-items: center;
    margin-top: 4px;
    margin-bottom: 4px;
    background-color: transparent;
    color: var(--unity-colors-toolbar_button-text);
    -unity-font-style: bold;
    border-color: transparent;
    transition: background-color 0.15s ease-in-out, color 0.15s ease-in-out;
}

.object-area-action-button:hover {
    background-color: var(--unity-colors-toolbar_button-background-hover);
    color: var(--unity-colors-toolbar_button-text-hover);
}

.object-area-column-items {
    width: 100%;
    height: auto;
    flex-grow: 0;
    flex-shrink: 0;
    display: flex;
    flex-wrap: wrap;
    flex-direction: row;
    margin-left: 8px;
    margin-right: 8px;
    margin-top: 6px;
    align-items: center;
}

.object-area-column-actions {
    display: flex;
    flex-direction: column;
    width: 300px;
    height: auto;
    align-items: center;
    margin-bottom: 4px;
}

.object-item {
    flex-direction: row;
    background-color: var(--unity-colors-default-background);
    border-radius: 6px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 8px;
    padding-right: 8px;
    margin-right: 4px;
    margin-top: 4px;
    align-items: center;
}

.object-icon {
    width: 16px;
    height: 16px;
    margin-right: 4px;
    opacity: 0.8;
}

.object-name {
    font-size: 12px;
    color: var(--unity-colors-text);
    margin-right: 4px;
}

.remove-button {
    width: 16px;
    height: 16px;
    margin: 0;
    background-color: transparent;
    opacity: 0.6;
    transition: scale 0.15s ease-in-out, opacity 0.15s ease-in-out;
}

.remove-button:hover {
    scale: 1.1;
    opacity: 0.8;
}

.selection-label {
    font-size: 12px;
    margin-right: 4px;
}

.attachment-label-icon {
    width: 14px;
    height: 14px;
    margin-right: 2px;
    opacity: 0.8;
}

.attachment-label {
    align-items: center;
    opacity: 0.8;
    -unity-font-style: bold;
}

.attachment-label-row {
    width: 100%;
    display: flex;
    flex-direction: row;
    margin-left: 8px;
    margin-right: 8px;
    margin-top: 2px;
    align-items: center;
    height: 20px;
}

.primary-button {
    width: 120px;
    height: 20px;
}

.error-message-label {
    font-size: 14px;
    color: var(--unity-colors-text);
    margin-left: 8px;
    margin-right: 8px;
    margin-top: 4px;
    margin-bottom: 4px;
}

.usage-container {
    display: flex;
    flex-direction: row;
    height: auto;
    margin-left: 8px;
    margin-right: 8px;
    margin-bottom: 4px;
    align-items: center;
    justify-content: center;
}

.usage-separator {
    width: 95%;
    align-self: center;
    opacity: 0.1;
    height: 1px;
    background-color: white;
    margin-top: 2px;
    margin-bottom: 2px;
}

.usage-label {
    font-size: 12px;
    color: var(--unity-colors-text);
    margin-left: 8px;
    margin-right: 8px;
    margin-top: 4px;
    margin-bottom: 4px;
}

.usage-flexible-spacer {
    flex-grow: 1;
    flex-shrink: 0;
    flex-basis: 0;
}

.cost-label {
    font-size: 12px;
    color: var(--unity-colors-text);
    margin-left: 8px;
    margin-right: 8px;
    margin-top: 4px;
    margin-bottom: 4px;
}

.prompt-history-button {
    width: 24px;
    height: 24px;
    background-color: var(--unity-colors-toolbar_button-background);
    border-color: transparent;
    transition: background-color 0.15s ease-in-out, color 0.15s ease-in-out;
}

.prompt-history-button:hover {
    background-color: var(--unity-colors-toolbar_button-background-hover);
}

.progress-bar {
    width: 100%;
    height: 8px;
}

.unity-progress-bar__background {
    background-color: var(--unity-colors-default-border);
}

.unity-progress-bar__progress {
    background-color: var(--ex-colors-indigo-button-background);
}

.progress-bar-label {
    font-size: 10px;
    color: var(--unity-colors-text);
    align-self: flex-end;
    margin-top: 2px;
    -unity-font-style: bold;
    opacity: 0.8;
}

.progress-bar-container {
    width: 100%;
    height: 8px;
    align-items: center;
    justify-content: center;
    align-self: center;
    opacity: 1;
    transition: height 0.2s ease-in-out, opacity 0.2s ease-in-out;
    background-color: transparent;
}

.title-bar {
    display: flex;
    flex-direction: row;
    width: 100%;
    height: 20px;
    align-items: center;
    justify-content: center;
    background-color: var(--unity-colors-popup-background);
    border-bottom-width: 1px;
}

.title-bar-label {
    font-size: 12px;
    color: var(--unity-colors-text);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.title-bar-button-container {
    display: flex;
    flex-direction: row;
    position: absolute;
    right: 6px;
}

.title-bar-button {
    width: 20px;
    height: 20px;
    background-color: transparent;
    opacity: 0.8;
    margin: 0px 2px;
    transition: scale 0.15s ease-in-out, opacity 0.15s ease-in-out;
}

.title-bar-button:hover {
    scale: 1.1;
    opacity: 1;
}