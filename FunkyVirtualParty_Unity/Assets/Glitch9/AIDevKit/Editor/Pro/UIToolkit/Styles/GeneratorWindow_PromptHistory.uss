.prompt-history-list-view-container {
    position: relative;
    overflow: hidden;
    min-height: 100px;
}

.prompt-history-list-view {
    flex-grow: 1;
    min-height: 100px;
    width: 100%;
    height: 100%;
    border-radius: 4px;
    border-width: 1px;
    color: var(--unity-colors-text-title);
    border-color: var(--unity-colors-default-border);
    background-color: var(--unity-colors-default-background);
}

.prompt-history-item {
    width: 100%;
    height: 100%;
    font-size: 11px;
    padding-left: 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
    border-left-width: 4px;
    border-left-color: #6699FF;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}