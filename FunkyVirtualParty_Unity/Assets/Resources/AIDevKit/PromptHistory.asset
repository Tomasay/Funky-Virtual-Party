              currencyCode: 840
              isEstimate: 0
            n: 1
            prompt: Tell me about this image.
            formattedPrompt: 
            outputMimeType: 1
            outputTexts:
            - 'Please provide me with the image or describe it to me. I need visual
              information about the image to tell you about it. For example, tell
              me:


              *   **What is in the image?** (People, animals,
              objects, landscapes, etc.)

              *   **What is the overall
              style or composition?** (Painting, photograph, cartoon, abstract, etc.)

              *  
              **What are the colors like?** (Bright, muted, dark, etc.)

              *  
              **What is the mood or feeling of the image?** (Happy, sad, peaceful,
              energetic, etc.)

              *   **Are there any specific details
              that stand out?** (Interesting textures, unusual perspectives, etc.)


              The
              more information you give me, the better I can understand the image
              and provide a helpful response.'
            inputFiles:
            - rid: -2
            outputFiles: []
        - key: 8b5d55ee-d3e6-4b4a-a1a8-d5e296041437
